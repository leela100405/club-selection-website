<div class="dashboard-heading"><div><div class="eyebrow">COORDINATOR SPACE</div><h1>Club selection <em>overview.</em></h1><p>Review student registrations and see where everyone's heading.</p></div><%= link_to "Export CSV ↓", admin_export_path(format: :csv), class: "submit-button inline-button" %></div>
<div class="stats"><div class="stat-card"><span>Total registrations</span><strong><%= @registrations.count %><small> / 70</small></strong><div class="progress"><i style="width:<%= @registrations.count * 100 / 70 %>%"></i></div></div><div class="stat-card"><span>Clubs represented</span><strong><%= @counts.keys.count %><small> / 7</small></strong></div><div class="stat-card"><span>Places remaining</span><strong><%= [70 - @registrations.count, 0].max %></strong></div></div>
<section class="panel"><div class="panel-heading"><div><div class="eyebrow">CLUB BREAKDOWN</div><h2>Interest by club</h2></div></div><div class="breakdown"><% Registration::CLUBS.each do |club| count = @counts.fetch(club, 0) %><div class="breakdown-row"><div class="breakdown-label"><span><%= club %></span><strong><%= count %></strong></div><div class="progress"><i style="width:<%= count * 100 / [@registrations.count, 1].max %>%"></i></div></div><% end %></div></section>
<section class="panel"><div class="panel-heading"><div><div class="eyebrow">STUDENT DIRECTORY</div><h2>All registrations</h2></div><span class="muted">Search by name, email, class or club</span></div><input id="student-search" class="search-box" type="search" placeholder="⌕  Search student records…"><div class="table-wrap"><table class="students-table" id="students-table"><thead><tr><th>Student</th><th>Class</th><th>Section</th><th>Email</th><th>Selected club</th></tr></thead><tbody><% @registrations.each do |r| %><tr><td><strong><%= r.student_name %></strong></td><td><%= r.student_class %></td><td><%= r.section %></td><td><%= r.email %></td><td><span class="club-badge"><%= r.club %></span></td></tr><% end %></tbody></table></div><p id="no-results" class="muted" hidden>No matching students found.</p></section>
<script>document.addEventListener('DOMContentLoaded',()=>{const input=document.getElementById('student-search');const rows=[...document.querySelectorAll('#students-table tbody tr')];const empty=document.getElementById('no-results');input.addEventListener('input',()=>{const q=input.value.toLowerCase();let shown=0;rows.forEach(row=>{const match=row.innerText.toLowerCase().includes(q);row.hidden=!match;if(match)shown++});empty.hidden=shown!==0;});});</script>
