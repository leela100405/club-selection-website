<section class="hero"><div class="eyebrow">YOUR CAMPUS, YOUR COMMUNITY</div><h1>Find your kind<br>of <em>people.</em></h1><p>Choose the club that sparks your curiosity. Meet people who share your interests.</p><div class="hero-pills"><span>7 student clubs</span><span>One choice per student</span><span>Up to 70 registrations</span></div></section>
<section class="panel"><div class="panel-heading"><div><div class="eyebrow">STUDENT REGISTRATION</div><h2>Make your selection</h2></div><span class="step">01 / 01</span></div>
<% if @registration.errors.any? %><div class="errors"><strong>Please check the following:</strong><ul><% @registration.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
<%= form_with model: @registration, class: "registration-form" do |f| %><div class="fields"><div class="field wide"><%= f.label :student_name, "Full name" %><%= f.text_field :student_name, placeholder: "Enter your full name", required: true %></div><div class="field"><%= f.label :student_class, "Class / year" %><%= f.text_field :student_class, placeholder: "e.g. B.Tech 4th Year", required: true %></div><div class="field"><%= f.label :section, "Section" %><%= f.text_field :section, placeholder: "e.g. A", required: true %></div><div class="field wide"><%= f.label :email, "College email address" %><%= f.email_field :email, placeholder: "you@college.edu", required: true %></div></div>
<div class="club-title"><div><div class="eyebrow">PICK YOUR PASSION</div><h3>Which club feels like you?</h3></div><span class="muted">Select one</span></div><div class="club-grid"><% Registration::CLUBS.each_with_index do |club, i| %><label class="club-option"><%= f.radio_button :club, club, required: true %><span class="club-icon"><%= ["✳", "✦", "♫", "↗", "▣", "♡", "♨"][i] %></span><span class="club-name"><%= club %></span><span class="club-desc"><%= ["Create and express", "Perform and tell stories", "Make some noise", "Move as a team", "Capture the moment", "Make a difference", "Cook up ideas"][i] %></span><span class="radio-dot"></span></label><% end %></div><div class="form-bottom"><span class="muted">Your email can be registered only once.</span><%= f.submit "Confirm my club →", class: "submit-button" %></div><% end %></section>
